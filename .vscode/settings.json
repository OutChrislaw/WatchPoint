{
    // "Run Code" builds the whole project and starts app.WatchPoint.
    // No batch file: -sourcepath makes javac pull in the other packages, so only
    // the entry point is named. All paths are absolute and quoted, so the
    // current directory and the spaces in "PF 101" do not matter.
    "code-runner.runInTerminal": false,
    "code-runner.fileDirectoryAsCwd": false,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.clearPreviousOutput": true,
    "code-runner.executorMap": {
        "java": "javac -d \"$workspaceRoot\\bin\" -sourcepath \"$workspaceRoot\\src\" \"$workspaceRoot\\src\\app\\WatchPoint.java\" && java -cp \"$workspaceRoot\\bin\" app.WatchPoint"
    }
}
