        "java": "javac -d \"$workspaceRoot\\bin\" -sourcepath \"$workspaceRoot\\src\" \"$workspaceRoot\\src\\app\\WatchPoint.java\" && java -cp \"$workspaceRoot\\bin\" app.WatchPoint"
    }
}
